// Cloudflare Workers(無料プラン)の設定。
// 訳があるページは静的ファイルとして配信し、それ以外のURLだけをWorker(src/entrypoints/worker/index.ts)が処理する。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ja-dev-docs",
  "compatibility_date": "2026-11-01",
  "main": "src/entrypoints/worker/index.ts",
  // ja-dev-docs.keke.works で公開する。keke.works はCloudflareのDNSにあるので、証明書もCloudflareが発行する。
  // ja.keke.works は以前のホスト名。ゾーンのリダイレクトルールでja-dev-docs.keke.worksへ転送するので、DNSのために残す。
  "routes": [
    { "pattern": "ja-dev-docs.keke.works", "custom_domain": true },
    { "pattern": "ja.keke.works", "custom_domain": true }
  ],
  "workers_dev": false,
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ja-dev-docs",
      // database_id は書かない。wranglerが名前でデータベースを引く。初回は scripts/deploy.sh が作る。
      "migrations_dir": "migrations"
    }
  ],
  // 同じIPからのリクエストは、1分に5回まで。
  "ratelimits": [{ "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": {
    // GitHub Actionsのワークフローを起動する先。
    "GITHUB_REPO": "kkun84/ja-dev-docs",
    "GITHUB_WORKFLOW": "translate.yml",
    "GITHUB_REF": "main",
    // TurnstileのサイトキーはHTMLに出る公開の値。デプロイ時に --var で本物に置き換える。
    // ここの値はCloudflareが用意しているテスト用のキー。
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
  // シークレット(scripts/deploy.sh がGitHubのシークレットから登録する):
  //   TURNSTILE_SECRET       Turnstileの秘密鍵
  //   GITHUB_DISPATCH_TOKEN  このリポジトリの Actions: write だけを持つ fine-grained token
}
