---
// VS Codeのドキュメントの訳のページ。原文のサイトと同じく、中央寄せの上部の帯、お知らせの帯、
// 左端から始まる3列(目次、本文、このページの内容)にする。ロゴは使わない。
import type { Page } from "../lib/pages.ts";
import type { NavNode } from "../lib/nav.ts";
import Head from "../components/article/Head.astro";
import Search from "../components/article/Search.astro";
import ThemeToggle from "../components/article/ThemeToggle.astro";
import Variants from "../components/article/Variants.astro";
import ModelSwitch from "../components/article/ModelSwitch.astro";
import TocSpy from "../components/article/TocSpy.astro";
import NavList from "../components/vscode/NavList.astro";
import "../styles/vscode.css";

interface Props {
  page: Page;
  tree: NavNode[];
  section: string;
  translated: Set<string>;
}
const { page, tree, section, translated } = Astro.props;
const { data } = page.primary;
const headings = (page.primary.rendered?.metadata?.headings ?? []).filter((h) => h.depth === 2);
// 訳があればこのサイトへ、無ければ原文のサイトへ。
const href = (id: string) => (translated.has(id) ? `/${id}/` : `https://${id}`);
const links = [
  ["Docs", "code.visualstudio.com/docs"],
  ["Release notes", "code.visualstudio.com/updates"],
  ["API", "code.visualstudio.com/api"],
] as const;
// 更新情報のように、目次が見出し1つだけのときは、その中身を直接並べる。
const nodes = tree.length === 1 && !tree[0]!.href ? tree[0]!.children : tree;
const sectionLabel = { docs: "ドキュメント", updates: "更新情報", api: "拡張機能API" }[section] ?? "ドキュメント";
---

<!doctype html>
<html lang="ja">
  <head>
    <Head title={data.title} description={data.description} siteName="Visual Studio Code" />
  </head>
  <body class="vsc">
    <a class="vsc-skip" href="#main-content">本文へ移動</a>
    <header class="vsc-header">
      <div class="vsc-header-inner">
        <a class="vsc-brand" href={href("code.visualstudio.com/docs")}>
          Visual Studio Code
          <span class="vsc-badge" title="GitHub、Microsoftとは関係のない、非公式の機械翻訳です">非公式の日本語訳</span>
        </a>
        <nav class="vsc-topnav" aria-label="原文のサイトの主な項目">
          {links.map(([label, id]) => <a href={href(id)} aria-current={section === id.split("/")[1] ? "true" : undefined}>{label}</a>)}
        </nav>
        <div class="vsc-tools">
          <button type="button" class="vsc-icon-button" data-search-open aria-label="検索">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.3" d="M9.5 2.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9ZM6.3 10.2 2 14.5" /></svg>
          </button>
          <ThemeToggle class="vsc-text-button" />
          <a class="vsc-cta" href={data.record.url}>原文(英語)を開く</a>
        </div>
      </div>
    </header>
    <div class="vsc-notice">
      <p>
        GitHub、Microsoftとは関係のない、非公式の機械翻訳です。正確な内容は<a href={data.record.url}>原文(英語)</a>で確認してください。
      </p>
    </div>

    <div class="vsc-layout">
      <nav class="vsc-sidebar" aria-label="ドキュメントの目次">
        <details class="vsc-sidebar-toggle" open data-sidebar-toggle>
          <summary>{sectionLabel}</summary>
          <h2 class="vsc-sidebar-title">{sectionLabel}</h2>
          <NavList nodes={nodes} />
        </details>
      </nav>

      <main id="main-content" class="vsc-content" data-pagefind-body>
        <h1 data-pagefind-meta="title">{data.title}</h1>
        <div class="vsc-actions" data-pagefind-ignore="all">
          <a class="vsc-split-button" href={data.record.url}>原文を開く</a>
          <ModelSwitch page={page} class="vsc-select" />
        </div>
        <Variants page={page} />
      </main>

      {
        headings.length > 1 && (
          <aside class="vsc-toc" aria-labelledby="vsc-toc-title">
            <h2 id="vsc-toc-title">このページの内容</h2>
            <ul data-toc>
              {headings.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    <footer class="vsc-footer">
      <div class="vsc-footer-inner">
        <p>
          <a href="/">開発者ドキュメント日本語訳(非公式)</a>
          ・<a href="/list/">訳したページの一覧</a>
          ・<a href="https://github.com/kkun84/ja-dev-docs">ソースコード</a>
        </p>
        <p>Visual Studio CodeおよびMicrosoftとは関係のない、個人による非公式の翻訳サイトです。</p>
      </div>
    </footer>
    <Search />
    <TocSpy />
    <script>
      // 狭い画面では、目次を閉じた状態で始める。
      const toggle = document.querySelector<HTMLDetailsElement>("[data-sidebar-toggle]");
      if (toggle && matchMedia("(max-width: 799px)").matches) toggle.open = false;
    </script>
  </body>
</html>
