    "remark-cjk-friendly": "^2.3.4",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "undici": "^8.12.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@mizchi/mutator": "0.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
