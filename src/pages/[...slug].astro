---
// 訳があるページ。ビルド時に静的なHTMLにする。原文のサイトごとに、その見た目に寄せたレイアウトを使う。
import { getPages, type Page } from "../lib/pages.ts";
import { breadcrumbs, navSection, navTree } from "../lib/nav.ts";
import VscodeLayout from "../layouts/VscodeLayout.astro";
import GithubLayout from "../layouts/GithubLayout.astro";

export async function getStaticPaths() {
  const pages = await getPages();
  const byId = new Map(pages.map((p) => [p.id, p]));
  const translated = new Set(byId.keys());
  return pages.map((page) => ({ params: { slug: page.id }, props: { page, tree: navTree(page.id, byId), translated } }));
}

interface Props {
  page: Page;
  tree: ReturnType<typeof navTree>;
  translated: Set<string>;
}
const { page, tree, translated } = Astro.props;
const { host, section } = navSection(page.id);
---

{
  host === "docs.github.com" ? (
    <GithubLayout page={page} tree={tree} crumbs={breadcrumbs(tree)} translated={translated} />
  ) : (
    <VscodeLayout page={page} tree={tree} section={section} translated={translated} />
  )
}
