---
// 訳があるページ。ビルド時に静的なHTMLにする。モデルごとの訳をすべて入れ、ブラウザで切り替える。
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { render } from "astro:content";
import { getPages, sidebar, type Page } from "../lib/pages.ts";
import { MODEL_LABELS } from "../lib/translations-loader.ts";
import Attribution from "../components/Attribution.astro";

export const prerender = true;

export async function getStaticPaths() {
  const pages = await getPages();
  const nav = sidebar(pages);
  return pages.map((page) => ({ params: { slug: page.id }, props: { page, nav } }));
}

interface Props {
  page: Page;
  nav: ReturnType<typeof sidebar>;
}
const { page, nav } = Astro.props;
const rendered = await Promise.all(page.variants.map(async (v) => ({ v, ...(await render(v)) })));
const primary = rendered[0]!;
---

<StarlightPage frontmatter={{ title: primary.v.data.title, description: primary.v.data.description }} headings={primary.headings} sidebar={nav}>
  {
    rendered.length > 1 && (
      <label class="model-switch">
        翻訳したモデル:
        <select data-model-select>
          {rendered.map(({ v }) => (
            <option value={v.data.record.model}>{MODEL_LABELS[v.data.record.model] ?? v.data.record.model}</option>
          ))}
        </select>
      </label>
    )
  }
  {
    rendered.map(({ v, Content }, i) => (
      <div data-model={v.data.record.model} data-pagefind-ignore={i > 0 ? "all" : undefined} hidden={i > 0}>
        <Content />
        <Attribution variant={v} />
      </div>
    ))
  }
</StarlightPage>

<script>
  // 読者が選んだモデルをブラウザに保存し、どのページでも同じモデルの訳を優先して見せる。
  const select = document.querySelector<HTMLSelectElement>("[data-model-select]");
  const show = (model: string) => {
    const blocks = [...document.querySelectorAll<HTMLElement>("[data-model]")];
    if (!blocks.some((b) => b.dataset.model === model)) return;
    for (const b of blocks) b.hidden = b.dataset.model !== model;
    if (select) select.value = model;
  };
  try {
    const saved = localStorage.getItem("model");
    if (saved) show(saved);
  } catch {}
  select?.addEventListener("change", () => {
    show(select.value);
    try {
      localStorage.setItem("model", select.value);
    } catch {}
  });
</script>

<style>
  .model-switch {
    display: block;
    font-size: var(--sl-text-sm);
    margin-bottom: 1rem;
  }
</style>
