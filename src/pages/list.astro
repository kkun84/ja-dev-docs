---
// 訳したページの一覧。サイドバーには同じ節のページしか載せないので、全ページはここから辿る。
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getPages, hostLabel } from "../lib/pages.ts";

const pages = (await getPages()).sort((a, b) => a.id.localeCompare(b.id));
const hosts = [...new Set(pages.map((p) => p.id.split("/")[0]!))];
---

<StarlightPage frontmatter={{ title: "訳したページの一覧" }}>
  {
    hosts.map((host) => (
      <>
        <h2>{hostLabel(host)}</h2>
        <ul>
          {pages
            .filter((p) => p.id.startsWith(host + "/"))
            .map((p) => (
              <li>
                <a href={`/${p.id}/`}>{p.primary.data.title}</a>
              </li>
            ))}
        </ul>
      </>
    ))
  }
</StarlightPage>
