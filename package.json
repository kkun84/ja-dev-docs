{
  "name": "ja-dev-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "node scripts/typecheck.ts",
    "lint": "oxlint --type-aware --deny-warnings && oxfmt --check && fallow --fail-on-issues && rumdl check . && node scripts/lint/ja-space/cli.ts && node scripts/lint/no-suppress/cli.ts && node scripts/lint/pnpm-policy/cli.ts",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "translate": "node pipeline/cli.ts",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check-env": "node scripts/check-env.ts",
    "check": "pnpm -s lint && pnpm -s typecheck && pnpm -s test:coverage && pnpm -s build",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.8",
    "astro": "7.4.10",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "remark-cjk-friendly": "2.3.4",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "undici": "8.12.4",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "fallow": "3.41.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "rumdl": "0.3.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  },
  "engines": {
    "node": "^24.22.1",
    "pnpm": "12.9.0"
  },
  "packageManager": "pnpm@12.9.0"
}
