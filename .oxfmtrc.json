{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "semi": false,
  "trailingComma": "none",
  "arrowParens": "always",
  // contentは翻訳のジョブが書く訳文、test/fixturesは原文の写し。pipeline、worker、src/lib、src/pages、src/components、src/content、astro.config.mjsは作り直す前のコードで、作り直しが済んだ層から順に消す。
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "test/fixtures/**",
    "content/**",
    "pipeline/**",
    "worker/**",
    "src/lib/**",
    "src/pages/**",
    "src/components/**",
    "src/content/**",
    "src/content.config.ts",
    "astro.config.mjs"
  ]
}
