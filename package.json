{
  "name": "ja-dev-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "mutation": "mutator",
    "mutation:diff": "mutator --since origin/main",
    "typecheck": "tsc --noEmit",
