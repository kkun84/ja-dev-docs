// 既定から変えた設定の理由はdocs/lint-history.mdにある。
{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/entrypoints/node/translate.ts",
    "src/entrypoints/node/job.ts",
    "src/entrypoints/node/published.ts",
    "astro.config.ts",
    "site/content.config.ts",
    "site/content/**/*.mdx",
    "site/pages/**/*.astro"
  ],
  // リポジトリの道具。ビルドやlintのスクリプトと、テスト。
  "supportEntry": ["scripts/*.ts", "scripts/lint/*/cli.ts", "vitest.config.ts", "src/**/*.test.ts", "scripts/**/*.test.ts"],
  "ignorePatterns": [".astro/**", ".wrangler/**"],
  // @effect/tsgoはscripts/typecheck.tsがバイナリとして呼び、@effect/language-serviceは
  // tsconfig.jsonのプラグインとして読み込むので、fallowからは使っているように見えない。
  "ignoreDependencies": ["@effect/language-service", "@effect/tsgo"],
  "rulePacks": ["architecture.rules.json"],
  // テストは、準備、実行、確認が1か所で読めることを優先し、重複を許す。
  "duplicates": {
    "ignore": ["**/*.test.ts"],
    "mode": "mild",
    "minTokens": 40,
    "minLines": 4,
    "ignoreDefaults": false,
    "threshold": 0.001
  },
  "boundaries": {
    "zones": [
      { "name": "unit-tests", "patterns": ["src/**/*.test.ts"] },
      { "name": "core", "patterns": ["src/core/**"] },
      { "name": "services", "patterns": ["src/services/**"] },
      { "name": "layers-d1", "patterns": ["src/layers/d1/**"] },
      { "name": "layers-http", "patterns": ["src/layers/http/**"] },
      { "name": "layers-shared", "patterns": ["src/layers/shared/**"] },
      { "name": "layers-cloudflare", "patterns": ["src/layers/cloudflare/**"] },
      { "name": "layers-node", "patterns": ["src/layers/node/**"] },
      { "name": "layers-test", "patterns": ["src/layers/test/**"] },
      { "name": "entrypoints-node", "patterns": ["src/entrypoints/node/**"] },
      { "name": "entrypoints-worker", "patterns": ["src/entrypoints/worker/**"] },
      { "name": "entrypoints-site", "patterns": ["src/entrypoints/site/**"] },
      { "name": "site", "patterns": ["site/**"] },
      { "name": "tooling", "patterns": ["scripts/**", "*.config.ts"] }
    ],
    "rules": [
      { "from": "core", "allow": ["core"] },
      { "from": "services", "allow": ["core", "services"] },
      { "from": "layers-d1", "allow": ["services", "core", "layers-d1"] },
      { "from": "layers-http", "allow": ["services", "core", "layers-http"] },
      { "from": "layers-shared", "allow": ["services", "core", "layers-shared"] },
      { "from": "layers-cloudflare", "allow": ["services", "core", "layers-d1", "layers-cloudflare"] },
      { "from": "layers-node", "allow": ["services", "core", "layers-d1", "layers-node"] },
      { "from": "layers-test", "allow": ["services", "core", "layers-d1", "layers-cloudflare", "layers-test"] },
      {
        "from": "entrypoints-node",
        "allow": ["layers-d1", "layers-http", "layers-shared", "layers-node", "services", "core", "entrypoints-node"]
      },
      {
        "from": "entrypoints-worker",
        "allow": ["layers-d1", "layers-http", "layers-shared", "layers-cloudflare", "services", "core", "entrypoints-worker"]
      },
      { "from": "entrypoints-site", "allow": ["entrypoints-node", "services", "core", "entrypoints-site"] },
      { "from": "site", "allow": ["entrypoints-site", "site"] },
      {
        "from": "unit-tests",
        "allow": [
          "core",
          "services",
          "layers-d1",
          "layers-http",
          "layers-shared",
          "layers-cloudflare",
          "layers-node",
          "layers-test",
          "entrypoints-worker",
          "unit-tests"
        ]
      }
    ],
    "coverage": {
      "requireAllFiles": true
    },
    "calls": {
      "forbidden": [
        { "from": "core", "callee": ["Date.now", "Math.random"] },
        { "from": "services", "callee": ["Date.now", "Math.random"] }
      ]
    }
  },
  "rules": {
    "unused-dev-dependencies": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "policy-violation": "error",
    "added-suppression": "error"
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 0
  }
}
