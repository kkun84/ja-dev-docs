{
  "name": "ja-dev-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -s sync && node scripts/typecheck.ts",
    "lint": "pnpm -s sync && oxlint --type-aware --deny-warnings && oxfmt --check && fallow --fail-on-issues && rumdl check . && node scripts/lint/ja-space/cli.ts && node scripts/lint/no-suppress/cli.ts && node scripts/lint/pnpm-policy/cli.ts",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "translate": "node src/entrypoints/node/translate.ts",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check-env": "node scripts/check-env.ts",
    "check": "pnpm -s lint && pnpm -s typecheck && pnpm -s test:coverage && pnpm -s build && pnpm -s build:worker",
    "prepare": "lefthook install",
    "build:worker": "node scripts/budget.ts",
    "sync": "astro sync"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.12",
    "effect": "4.1.4",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "undici": "8.12.4",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@effect/vitest": "4.1.4",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "fallow": "3.43.1",
    "lefthook": "2.2.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "remark-cjk-friendly": "2.3.4",
    "rumdl": "0.3.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": "^24.22.1",
    "pnpm": "12.9.0"
  },
  "packageManager": "pnpm@12.9.0"
}
